<?xml version="1.0" encoding="utf-8"?>
<!-- Density-independent copy of the notification small icon (the audiflow
     mark traced from the drawable-*dpi PNGs), used where no PNG density
     fits. It does not by itself keep the icon in the base APK: App Bundle
     density splits take this copy along with the PNGs, which is why
     build.gradle.kts turns density splitting off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <path
        android:pathData="M33,32L63,14M33,57L63,39M33,82L63,64"
        android:strokeWidth="14"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />
</vector>
