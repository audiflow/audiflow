<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon is masked to a circle covering roughly two thirds
     of the drawable; inset the mark so it stays fully inside the safe zone. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/launch_mark"
    android:insetLeft="25%"
    android:insetTop="25%"
    android:insetRight="25%"
    android:insetBottom="25%" />
